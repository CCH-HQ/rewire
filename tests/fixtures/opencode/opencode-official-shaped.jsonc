{
  "$schema": "https://opencode.ai/config.json",
  "model": "existing/gpt-5.5",
  "provider": {
    "existing": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Existing compatible provider",
      "options": {
        "baseURL": "https://existing-gateway.example/v1",
        "apiKey": "{env:EXISTING_TOKEN}"
      },
      "models": {
        "gpt-5.5": {
          "id": "gpt-5.5",
          "name": "GPT-5.5"
        }
      }
    }
  },
  "mcp": {
    "docs": {
      "type": "local",
      "command": ["docs-server", "--stdio"]
    }
  },
  "instructions": ["CONTRIBUTING.md"]
}
