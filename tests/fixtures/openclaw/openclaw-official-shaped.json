{
  "models": {
    "mode": "merge",
    "providers": {
      "existing-proxy": {
        "baseUrl": "https://existing-gateway.example/v1",
        "apiKey": "${EXISTING_TOKEN}",
        "api": "openai-completions",
        "models": [
          {
            "id": "coder-model",
            "name": "Coder Model",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 128000,
            "maxTokens": 8192
          },
          {
            "id": "claude-existing",
            "name": "Existing Claude",
            "api": "anthropic-messages",
            "baseUrl": "https://existing-anthropic.example",
            "reasoning": true,
            "input": ["text", "image"],
            "contextWindow": 200000,
            "maxTokens": 16384
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "workspace": "~/workspace",
      "model": {"primary": "existing-proxy/coder-model"}
    }
  },
  "gateway": {
    "reload": true
  }
}
